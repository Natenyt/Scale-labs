# Railway/nixpacks sets NODE_ENV=production for the build, which makes
# `npm ci` omit devDependencies. But the production build NEEDS several
# dev packages at build time — @tailwindcss/postcss + tailwindcss (PostCSS
# compile of globals.css), typescript + @types/* (type-check), and
# eslint-config-next (lint). `include=dev` forces npm to install them
# regardless of NODE_ENV, which is documented to override the implied omit.
include=dev
